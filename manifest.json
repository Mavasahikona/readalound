{
  "manifest_version": 3,
  "name": "Sentence Reader (Kokoro / Microsoft TTS)",
  "version": "1.5.0",
  "description": "Reads web pages aloud with built-in Kokoro voices (no install), Azure Neural or browser voices, and highlights the current sentence.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "offscreen",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentence Reader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-read": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start / pause / resume reading"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
